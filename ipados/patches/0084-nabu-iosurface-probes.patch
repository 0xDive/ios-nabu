 /*
  * Publish physical memory (the panel framebuffer) as a surface. Returns a
  * retained surface that stays in the id table until released by the caller

diff --git a/iokit/Kernel/arm/NabuSurface.cpp b/iokit/Kernel/arm/NabuSurface.cpp
--- a/iokit/Kernel/arm/NabuSurface.cpp
+++ b/iokit/Kernel/arm/NabuSurface.cpp
@@ -181,8 +181,88 @@
 	}
 	IOLockUnlock(nabu_surface_lock);
 	return s;
 }
+
+/* Select a userspace BGRA screen-sized buffer without retaining stale pointers. */
+static bool
+nabu_surface_bgra_candidate(const NabuSurface *s)
+{
+	if (s == NULL || s->memory == NULL || s->pixelFormat != 0x42475241 ||
+	    s->bytesPerElement != 4 || s->width < 1000 || s->height < 1000 ||
+	    s->bytesPerRow < (uint64_t)s->width * 4) {
+		return false;
+	}
+	if (OSDynamicCast(IOBufferMemoryDescriptor, s->memory) == NULL) {
+		return false; /* exclude the physical panel surface */
+	}
+	return (uint64_t)s->offset + (uint64_t)s->bytesPerRow * s->height <=
+	    (uint64_t)s->memory->getLength();
+}
+
+uint32_t
+nabu_surface_bgra_hint_id(void)
+{
+	if (nabu_surface_lock == NULL) {
+		return 0;
+	}
+	uint32_t hint = 0;
+	uint64_t best = 0;
+	IOLockLock(nabu_surface_lock);
+	for (uint32_t id = 1; id < NABU_SURFACE_MAX_ID; id++) {
+		const NabuSurface *s = nabu_surface_table[id];
+		if (!nabu_surface_bgra_candidate(s)) {
+			continue;
+		}
+		uint64_t score = (uint64_t)s->width * s->height;
+		if (s->width == 1668 && s->height == 2224) {
+			score += (1ULL << 48);
+		}
+		if (score >= best) {
+			best = score;
+			hint = id;
+		}
+	}
+	IOLockUnlock(nabu_surface_lock);
+	return hint;
+}
+
+void
+nabu_surface_probe_all(void)
+{
+	struct nabu_probe_record {
+		uint32_t id, width, height, fmt, stride;
+	};
+	nabu_probe_record snap[16];
+	unsigned total = 0;
+	if (nabu_surface_lock == NULL) {
+		IOLog("NABU SURF: probe skipped (table not initialized)\n");
+		return;
+	}
+	IOLockLock(nabu_surface_lock);
+	for (uint32_t id = 1; id < NABU_SURFACE_MAX_ID; id++) {
+		NabuSurface *s = nabu_surface_table[id];
+		if (!nabu_surface_bgra_candidate(s)) {
+			continue;
+		}
+		if (total < 16) {
+			snap[total].id = id;
+			snap[total].width = s->width;
+			snap[total].height = s->height;
+			snap[total].fmt = s->pixelFormat;
+			snap[total].stride = s->bytesPerRow;
+		}
+		total++;
+	}
+	IOLockUnlock(nabu_surface_lock);
+	IOLog("NABU SURF: probe BGRA candidates %u (showing %u)\n",
+	    total, total < 16 ? total : 16);
+	for (unsigned i = 0; i < total && i < 16; i++) {
+		IOLog("NABU SURF:   id %u %ux%u fmt 0x%x stride %u\n",
+		    snap[i].id, snap[i].width, snap[i].height, snap[i].fmt,
+		    snap[i].stride);
+	}
+}
 
 /* The table lock; the framebuffer may publish a surface before the root starts. */
 static void
 nabu_surface_init_lock(void)
