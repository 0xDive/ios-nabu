+/*
+ * Diagnostic surface inventory used by the iPad framebuffer fallback.
+ * Snapshot metadata under the lock, and log only after releasing it.
+ */
+void
+nabu_surface_probe_all(void)
+{
+	struct probe_entry {
+		uint32_t id, width, height, bytesPerRow, pixelFormat, users;
+	};
+	struct probe_entry found[16];
+	uint32_t used = 0, total = 0;
+	if (nabu_surface_lock == NULL) {
+		IOLog("NABU SURF: probe: table not initialized\n");
+		return;
+	}
+	IOLockLock(nabu_surface_lock);
+	for (uint32_t i = 1; i < NABU_SURFACE_MAX_ID; ++i) {
+		NabuSurface *s = nabu_surface_table[i];
+		if (s == NULL || s->width == 0 || s->height == 0) {
+			continue;
+		}
+		++total;
+		if (used < (sizeof(found) / sizeof(found[0]))) {
+			found[used].id = s->id;
+			found[used].width = s->width;
+			found[used].height = s->height;
+			found[used].bytesPerRow = s->bytesPerRow;
+			found[used].pixelFormat = s->pixelFormat;
+			found[used].users = nabu_surface_users[i];
+			++used;
+		}
+	}
+	IOLockUnlock(nabu_surface_lock);
+	IOLog("NABU SURF: probe: %u live, showing %u, BGRA hint %u\n",
+	    total, used, nabu_surface_bgra_hint_id());
+	for (uint32_t i = 0; i < used; i++) {
+		IOLog("NABU SURF: id %u %ux%u row %u fmt 0x%x users %u\n",
+		    found[i].id, found[i].width, found[i].height,
+		    found[i].bytesPerRow, found[i].pixelFormat, found[i].users);
+	}
+}
+
+/*
+ * Backboardd sometimes sends empty SwapEnd layer IDs even though its CPU
+ * renderer has committed a real IOSurface. Prefer the iPad7,3 render size
+ * and never mistake the panel's physical IOSurface for a render buffer.
+ */
+uint32_t
+nabu_surface_bgra_hint_id(void)
+{
+	uint32_t best = 0;
+	uint64_t bestScore = 0;
+	if (nabu_surface_lock == NULL) {
+		return 0;
+	}
+	IOLockLock(nabu_surface_lock);
+	for (uint32_t i = 1; i < NABU_SURFACE_MAX_ID; ++i) {
+		NabuSurface *s = nabu_surface_table[i];
+		if (s == NULL || s->memory == NULL ||
+		    s->pixelFormat != 0x42475241u || s->bytesPerElement != 4 ||
+		    s->width < 500 || s->height < 500 || s->bytesPerRow == 0 ||
+		    OSDynamicCast(IOBufferMemoryDescriptor, s->memory) == NULL) {
+			continue;
+		}
+		if ((uint64_t)s->offset + (uint64_t)s->height * s->bytesPerRow >
+		    s->memory->getLength()) {
+			continue;
+		}
+		uint64_t score = (uint64_t)s->width * s->height;
+		if (s->width == 1668 && s->height == 2224) {
+			score += (1ULL << 40);
+		}
+		if (score >= bestScore) {
+			bestScore = score;
+			best = s->id;
+		}
+	}
+	IOLockUnlock(nabu_surface_lock);
+	return best;
+}
 #endif /* NABU */
