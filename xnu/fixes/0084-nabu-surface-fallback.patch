 	IOLockUnlock(nabu_surface_lock);
 	return s;
 }
 
+/* Return a candidate IOSurface for the iPad7,3 1668x2224 BGRA canvas. */
+uint32_t
+nabu_surface_bgra_hint_id(void)
+{
+    uint32_t best = 0;
+    if (nabu_surface_lock == NULL) {
+        return 0;
+    }
+    IOLockLock(nabu_surface_lock);
+    for (uint32_t id = 1; id < NABU_SURFACE_MAX_ID; ++id) {
+        NabuSurface *s = nabu_surface_table[id];
+        if (s != NULL && s->memory != NULL &&
+            s->pixelFormat == 0x42475241u && s->bytesPerElement == 4 &&
+            s->width == 1668u && s->height == 2224u) {
+            best = id;
+        }
+    }
+    IOLockUnlock(nabu_surface_lock);
+    return best;
+}
+
+/* Framebuffer bring-up diagnostic; never map or touch surface pixels here. */
+void
+nabu_surface_probe_all(void)
+{
+    IOLog("NABU SURFACE: iPad7,3 BGRA hint id=%u\n",
+        nabu_surface_bgra_hint_id());
+}
+
 /* The table lock; the framebuffer may publish a surface before the root starts. */
 static void
